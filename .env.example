# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# https://console.anthropic.com/settings/keys  (the agent and the web app call the model with this key)
ANTHROPIC_API_KEY=your_key_here

# Optional
# DB_PATH=./data/economic_pulse.db
# CACHE_TTL_FRED=86400
# CACHE_TTL_STOCK=3600

# Approval gate (approval.py): when the CLI or the web app asks before running a tool
# APPROVAL_MAX_OBSERVATIONS=1300           # uncached download estimated above this many observations
# APPROVAL_MAX_TOOL_CALLS_PER_TURN=4       # more tool calls than this already made for one question
# APPROVAL_SESSION_COST_USD=0.15           # session model cost above this
